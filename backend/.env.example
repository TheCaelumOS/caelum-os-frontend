# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caelum_os?schema=public"

# Authentication & Security
PORT=4000
JWT_SECRET="caelum_os_production_jwt_secret_change_me_in_production"
ENCRYPTION_KEY="caelum_os_token_encryption_key_32_bytes_long!"

# Frontend URLs
FRONTEND_URL="http://localhost:3000"

# Real GitHub App OAuth Integration
GITHUB_APP_ID="your_github_app_id"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"
GITHUB_CALLBACK_URL="http://localhost:4000/github/callback"
GITHUB_API_URL="https://api.github.com"
